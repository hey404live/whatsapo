DATABASE_URL=postgresql://whatsapo:whatsapo_local@127.0.0.1:5432/whatsapo

# Cloudflare R2. En local usa api/.env.r2.local; en despliegue configura variables del servidor.
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
UPLOAD_MAX_SIZE_MB=10
# Lista separada por comas. Vacía permite cualquier tipo MIME válido.
UPLOAD_ALLOWED_MIME_TYPES=
